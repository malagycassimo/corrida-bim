// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Participant {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    BI                  String    @unique
    firstName           String
    lastName            String
    email               String    @unique
    phone               String
    province            String
    dob                 String
    country             String
    gender              String
    emergencyName       String
    emergencyPhone      String
    emergencyFamiliarity String
    category            String
    route               String
    shirt               String
    @@index([BI, email, phone])
}
