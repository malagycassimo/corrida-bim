generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Participant {
    id                  String   @id @default(uuid())
    IDCode              String   @unique
    firstName           String
    lastName            String
    email               String
    phone               String
    province            String
    dob                 String
    country             String
    gender              String
    emergencyName       String
    emergencyPhone      String
    emergencyFamiliarity String
    category            String
    route               String
    shirt               String

    @@index([IDCode, email, phone])
}

model Setting {
    key       String   @id
    value     String
    updatedAt DateTime @updatedAt
}
